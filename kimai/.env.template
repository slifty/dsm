# See https://www.kimai.org/documentation/local-yaml.html#env
# Environment for the runtime (always use prod, other option is dev if you want to developfor Kimai)
APP_ENV=prod
ADMINMAIL=${ADMIN_EMAIL}
ADMINPASS=${ADMIN_PASSWORD}

# SMTP connection for emails
## Setting these in pieces since it is easier to maintain
MAIL_MAILER=${MAIL_MAILER}
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}

## Actually used by kimai
MAILER_URL=${MAIL_MAILER}://${MAIL_USERNAME}:${MAIL_PASSWORD}@${MAIL_HOST}:${MAIL_PORT}?encryption=${MAIL_ENCRYPTION}
MAILER_FROM=${MAILER_FROM}

# secret used to encrypt e.g. session cookies (users will be logged out if you change it)
APP_SECRET=${APP_SECRET}

# Database settings
DB_DATABASE=${DB_DATABASE}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@kimai-db/kimai?charset=utf8mb4&serverVersion=5.7.40"
